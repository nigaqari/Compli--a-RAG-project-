# Compli Backend Environment Variables Template
# Copy this file to .env and fill in your actual production/development credentials

DATABASE_URL=sqlite:///./compli.db
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]
ENV=dev
GROQ_API_KEY=your_groq_api_key_here

# Gmail SMTP OTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
FROM_EMAIL=your_email@gmail.com
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
